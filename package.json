{
  "name": "electorn-chinese-chess",
  "productName": "飞将象棋",
  "version": "0.0.15",
  "description": "飞将象棋是一款基于Electorn开发的开源象棋软件",
  "main": ".webpack/main",
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/imbatony/electorn-chinese-chess",
  "bugs": {
    "url": "https://github.com/imbatony/electorn-chinese-chess/issues"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:prod": "cross-env NODE_ENV=production electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "lint:fix": "eslint --fix --ext .ts,.tsx .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "knip": "knip",
    "code:clean": "npm run format && npm run lint:fix",
    "test": "jest",
    "testInBand": "jest --runInBand --detectOpenHandles",
    "test-c": "jest --coverage",
    "clean": "rimraf ./out"
  },
  "keywords": [],
  "author": {
    "name": "esfak47",
    "email": "esfak47@qq.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.23",
    "@types/react": "^17.0.90",
    "@types/react-dom": "^17.0.26",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "@vercel/webpack-asset-relocator-loader": "^1.10.0",
    "cross-env": "^10.1.0",
    "css-loader": "^6.11.0",
    "electron": "^28.3.3",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.3.0",
    "fork-ts-checker-webpack-plugin": "^6.5.3",
    "jest": "^30.2.0",
    "knip": "^5.82.1",
    "node-loader": "^2.1.0",
    "prettier": "^3.8.0",
    "rimraf": "^6.1.2",
    "style-loader": "^3.3.4",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@electron/remote": "^2.1.3",
    "electron-squirrel-startup": "^1.0.1",
    "konva": "^8.4.3",
    "lodash": "^4.17.21",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-konva": "^17.0.2-6",
    "react-router-dom": "^6.30.3"
  }
}
